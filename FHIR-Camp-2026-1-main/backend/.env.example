FHIR_BASE_URL=https://hapi.fhir.org/baseR4
# Si usas otro HAPI público o un endpoint con /fhir, cámbialo aquí.
# Ejemplo: https://server.example.com/fhir

# Para evitar colisiones entre grupos en un HAPI público.
FHIR_NAMESPACE=asmed-grupo-01

# Permite CORS del frontend local
FRONTEND_ORIGIN=http://localhost:5173
